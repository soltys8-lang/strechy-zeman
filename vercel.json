{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.strechynakliczeman.cz" }],
      "destination": "https://strechynakliczeman.cz/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.strechynakliczeman.cz" }],
      "destination": "https://strechynakliczeman.cz/:path*",
      "permanent": true
    }
  ]
}
